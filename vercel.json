{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*\\.(?:jpg|jpeg|png|webp|svg|ico|woff2))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/receta/:slug",
      "destination": "/api/index?receta=:slug"
    },
    {
      "source": "/recetas/:slug",
      "destination": "/api/index?receta=:slug"
    },
    {
      "source": "/r/:slug",
      "destination": "/api/index?receta=:slug"
    }
  ]
}
